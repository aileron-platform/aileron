{
  "realm": "aileron",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "aileron-manager",
      "name": "Aileron Workspace Manager",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-manager-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/api/v1/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8082/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "email"
      ]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "openldap",
        "providerId": "ldap",
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "fullSyncPeriod": ["-1"],
          "changedSyncPeriod": ["-1"],
          "cachePolicy": ["DEFAULT"],
          "editMode": ["READ_ONLY"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson", "organizationalPerson"],
          "connectionUrl": ["ldap://openldap:389"],
          "usersDn": ["ou=people,dc=aileron,dc=local"],
          "authType": ["simple"],
          "bindDn": ["cn=admin,dc=aileron,dc=local"],
          "bindCredential": ["admin"],
          "searchScope": ["1"],
          "useTruststoreSpi": ["ldapsOnly"],
          "connectionPooling": ["true"],
          "pagination": ["true"],
          "importEnabled": ["true"],
          "customUserSearchFilter": ["(!(pwdAccountLockedTime=*))"],
          "allowKerberosAuthentication": ["false"],
          "debug": ["false"],
          "useKerberosForPasswordAuthentication": ["false"],
          "trustEmail": ["false"]
        }
      }
    ]
  },
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "admin",
      "enabled": true,
      "email": "admin@aileron.com",
      "emailVerified": true,
      "firstName": "Aileron",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ]
    }
  ]
}

{
  "realm": "aileron",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "__OIDC_CLIENT_ID__",
      "name": "Aileron Workspace Manager",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__OIDC_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "__OIDC_CALLBACK_URL__"
      ],
      "webOrigins": [
        "__PLATFORM_PUBLIC_ORIGIN__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__OIDC_LOGOUT_PATTERN__"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "id": "__PLATFORM_ADMIN_SUBJECT__",
      "username": "__PLATFORM_ADMIN_USERNAME__",
      "enabled": true,
      "email": "__PLATFORM_ADMIN_EMAIL__",
      "emailVerified": true,
      "firstName": "Aileron",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "__PLATFORM_ADMIN_PASSWORD__",
          "temporary": false
        }
      ]
    }
  ]
}

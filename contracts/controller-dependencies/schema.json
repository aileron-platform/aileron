{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aileron.dev/contracts/controller-dependencies/schema.json",
  "title": "Controller Dependency Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "dependencies"],
  "properties": {
    "contractVersion": {"const": "1"},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "ownerController", "apiGroup", "resource", "scope", "typedObject", "accessMode", "verbs", "enabledCondition"],
        "properties": {
          "identity": {"type": "string", "minLength": 1},
          "ownerController": {"enum": ["workspace-controller", "workspace-firewall-attestor"]},
          "apiGroup": {"type": "string"},
          "resource": {"type": "string", "minLength": 1},
          "scope": {"enum": ["namespaced", "cluster"]},
          "typedObject": {"type": "string", "minLength": 1},
          "accessMode": {"enum": ["watched", "cached", "directLookup"]},
          "verbs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["create", "delete", "get", "list", "patch", "update", "watch"]}},
          "enabledCondition": {"enum": ["always", "ciliumEnabled", "storageClassesConfigured"]},
          "eventMapperIdentity": {"type": "string", "minLength": 1},
          "probeIdentity": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"accessMode": {"const": "watched"}}}, "then": {"required": ["eventMapperIdentity"]}, "else": {"not": {"required": ["eventMapperIdentity"]}}},
          {"if": {"properties": {"accessMode": {"const": "directLookup"}}}, "then": {"required": ["probeIdentity"]}, "else": {"not": {"required": ["probeIdentity"]}}}
        ]
      }
    }
  }
}

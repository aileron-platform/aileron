{
  "version": "platform-secret-installation/v1",
  "artifacts": [
    {"id": "postgres-username", "path": "platform/postgres-username", "source": "generated", "format": "postgresUsername", "when": "postgres.enabled=true"},
    {"id": "postgres-password", "path": "platform/postgres-password", "source": "generated", "format": "urlSafeToken", "when": "postgres.enabled=true"},
    {"id": "database-url", "path": "platform/database-url", "source": "selected", "format": "databaseUrl", "selector": "postgres.enabled"},
    {"id": "runtime-database-credential-key", "path": "platform/runtime-database-credential-key", "source": "generated", "format": "urlSafeToken64"},
    {"id": "runtime-assertion-private-key", "path": "runtime-assertions/private-key.pem", "source": "generated", "format": "ed25519PrivatePem"},
    {"id": "runtime-assertion-public-jwks", "path": "runtime-assertions/jwks.json", "source": "generated", "format": "ed25519Jwks"},
    {"id": "browser-credential-keyring", "path": "browser/keyring.json", "source": "generated", "format": "browserKeyring"},
    {"id": "turn-rest-shared-secret", "path": "turn/turn-rest-shared-secret", "source": "generated", "format": "urlSafeToken"},
    {"id": "turn-backend-ice-servers", "path": "turn/backend-ice-servers-json", "source": "generated", "format": "iceServers"},
    {"id": "turn-frontend-ice-servers", "path": "turn/frontend-ice-servers-json", "source": "generated", "format": "iceServers"},
    {"id": "coturn-probe-username", "path": "coturn/probe-username", "source": "generated", "format": "nonEmpty"},
    {"id": "coturn-probe-credential", "path": "coturn/probe-credential", "source": "generated", "format": "urlSafeToken"},
    {"id": "connectivity-internal-token", "path": "connectivity/internal-token", "source": "generated", "format": "urlSafeToken"},
    {"id": "connectivity-agent-host-token", "path": "connectivity/agent-host-token", "source": "generated", "format": "urlSafeToken"},
    {"id": "connectivity-agent-tokens", "path": "connectivity/agent-tokens-json", "source": "generated", "format": "agentTokens"},
    {"id": "connectivity-probe-ice-servers", "path": "connectivity/probe-ice-servers-json", "source": "generated", "format": "iceServers"},
    {"id": "oidc-client-secret", "source": "external", "format": "nonEmpty"},
    {"id": "oidc-ca", "source": "external", "format": "pemCertificate"},
    {"id": "apps-tls-cert", "source": "external", "format": "pemCertificate"},
    {"id": "apps-tls-key", "source": "external", "format": "pemPrivateKey"},
    {"id": "apps-tls-ca", "source": "external", "format": "pemCertificate"},
    {"id": "harbor-dockerconfig", "source": "external", "format": "dockerConfigJson"},
    {"id": "platform-database-ca", "source": "external", "format": "pemCertificate", "when": "postgres.enabled=false"},
    {"id": "redis-general-url", "source": "external", "format": "redisUrl", "when": "redis.enabled=false"},
    {"id": "redis-job-queue-url", "source": "external", "format": "redisUrl", "when": "redis.enabled=false"},
    {"id": "redis-job-result-url", "source": "external", "format": "redisUrl", "when": "redis.enabled=false"},
    {"id": "redis-general-ca", "source": "external", "format": "pemCertificate", "when": "redis.enabled=false"},
    {"id": "redis-job-queue-ca", "source": "external", "format": "pemCertificate", "when": "redis.enabled=false"},
    {"id": "redis-job-result-ca", "source": "external", "format": "pemCertificate", "when": "redis.enabled=false"}
  ],
  "secrets": [
    {"namespace": "workspace-system", "name": "aileron-platform-secrets", "type": "Opaque", "data": {"database-url": "database-url", "runtime-database-credential-key": "runtime-database-credential-key", "postgres-username": "postgres-username", "postgres-password": "postgres-password"}, "dataWhen": {"postgres-username": "postgres.enabled=true", "postgres-password": "postgres.enabled=true"}},
    {"namespace": "workspace-system", "name": "aileron-platform-database-ca", "type": "Opaque", "when": "postgres.enabled=false", "data": {"ca.crt": "platform-database-ca"}},
    {"namespace": "workspace-system", "name": "aileron-external-data-services", "type": "Opaque", "when": "redis.enabled=false", "data": {"redis-general-url": "redis-general-url", "redis-job-queue-url": "redis-job-queue-url", "redis-job-result-url": "redis-job-result-url"}},
    {"namespace": "workspace-system", "name": "aileron-redis-general-ca", "type": "Opaque", "when": "redis.enabled=false", "data": {"ca.crt": "redis-general-ca"}},
    {"namespace": "workspace-system", "name": "aileron-redis-job-queue-ca", "type": "Opaque", "when": "redis.enabled=false", "data": {"ca.crt": "redis-job-queue-ca"}},
    {"namespace": "workspace-system", "name": "aileron-redis-job-result-ca", "type": "Opaque", "when": "redis.enabled=false", "data": {"ca.crt": "redis-job-result-ca"}},
    {"namespace": "workspace-system", "name": "runtime-assertion-signer", "type": "Opaque", "data": {"private-key.pem": "runtime-assertion-private-key"}},
    {"namespace": "workspace-system", "name": "runtime-assertion-public-jwks", "type": "Opaque", "data": {"jwks.json": "runtime-assertion-public-jwks"}},
    {"namespace": "workspace-system", "name": "browser-credential-keyring", "type": "Opaque", "data": {"keyring.json": "browser-credential-keyring"}},
    {"namespace": "workspace-system", "name": "aileron-turn-ice", "type": "Opaque", "data": {"backend-ice-servers-json": "turn-backend-ice-servers", "frontend-ice-servers-json": "turn-frontend-ice-servers", "turn-rest-shared-secret": "turn-rest-shared-secret", "probe-username": "coturn-probe-username", "probe-credential": "coturn-probe-credential"}},
    {"namespace": "workspace-system", "name": "aileron-connectivity-evidence", "type": "Opaque", "data": {"internal-token": "connectivity-internal-token", "agent-tokens-json": "connectivity-agent-tokens", "agent-host-token": "connectivity-agent-host-token", "probe-ice-servers-json": "connectivity-probe-ice-servers", "turn-rest-shared-secret": "turn-rest-shared-secret"}},
    {"namespace": "workspace-system", "name": "aileron-oidc-client", "type": "Opaque", "data": {"client-secret": "oidc-client-secret"}},
    {"namespace": "workspace-system", "name": "aileron-oidc-ca", "type": "Opaque", "data": {"ca.crt": "oidc-ca"}},
    {"namespace": "workspace-system", "name": "aileron-apps-tls", "type": "kubernetes.io/tls", "data": {"tls.crt": "apps-tls-cert", "tls.key": "apps-tls-key", "ca.crt": "apps-tls-ca"}},
    {"namespace": "workspace-system", "name": "harbor-rke-creds", "type": "kubernetes.io/dockerconfigjson", "data": {".dockerconfigjson": "harbor-dockerconfig"}},
    {"namespace": "aileron-turn-system", "name": "aileron-coturn-auth", "type": "Opaque", "data": {"turn-rest-shared-secret": "turn-rest-shared-secret", "probe-username": "coturn-probe-username", "probe-credential": "coturn-probe-credential"}},
    {"namespace": "aileron-turn-system", "name": "harbor-rke-creds", "type": "kubernetes.io/dockerconfigjson", "data": {".dockerconfigjson": "harbor-dockerconfig"}}
  ]
}

    "turn-path-evidence.schema.json": {
      "$defs": {
        "evidence": {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "not": {
                  "required": [
                    "relayAddress"
                  ]
                },
                "required": [
                  "errorCode"
                ]
              },
              "if": {
                "properties": {
                  "outcome": {
                    "const": "success"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "errorCode"
                  ]
                },
                "required": [
                  "relayAddress"
                ]
              }
            }
          ],
          "properties": {
            "acceptedAt": {
              "format": "date-time",
              "type": "string"
            },
            "contractVersion": {
              "const": "browser-connectivity/v1"
            },
            "credentialRevision": {
              "minLength": 1,
              "type": "string"
            },
            "errorCode": {
              "minLength": 1,
              "type": "string"
            },
            "expiresAt": {
              "format": "date-time",
              "type": "string"
            },
            "measuredAt": {
              "format": "date-time",
              "type": "string"
            },
            "outcome": {
              "enum": [
                "success",
                "failure"
              ]
            },
            "producer": {
              "$ref": "#/$defs/producer"
            },
            "profileRevision": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "relayAddress": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "contractVersion",
            "producer",
            "profileRevision",
            "credentialRevision",
            "outcome",
            "acceptedAt",
            "expiresAt"
          ],
          "type": "object"
        },
        "producer": {
          "additionalProperties": false,
          "properties": {
            "installationId": {
              "minLength": 1,
              "type": "string"
            },
            "vantageId": {
              "minLength": 1,

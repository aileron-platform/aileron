{
  "contracts": {
    "browser-connectivity-projection.schema.json": {
      "$id": "https://aileron.dev/contracts/browser-connectivity/browser-connectivity-projection.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "admission": {
                "const": "denied"
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "ready",
                  "degraded"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "admission": {
                "const": "allowed"
              }
            },
            "required": [
              "profileRevision",
              "credentialRevision",
              "acceptedAt",
              "expiresAt"
            ]
          }
        }
      ],
      "properties": {
        "acceptedAt": {
          "format": "date-time",
          "type": "string"
        },
        "admission": {
          "enum": [
            "allowed",
            "denied"
          ]
        },
        "backendAcceptedAt": {
          "format": "date-time",
          "type": "string"
        },
        "backendErrorCode": {
          "type": "string"
        },
        "backendExpiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "backendReason": {
          "type": "string"
        },
        "backendState": {
          "enum": [
            "pending",
            "ready",
            "degraded",
            "not_ready",
            "unavailable"
          ]
        },
        "contractVersion": {
          "const": "browser-connectivity/v1"
        },
        "credentialRevision": {
          "minLength": 1,
          "type": "string"
        },
        "errorCode": {
          "enum": [
            "TURN_PROFILE_UNAVAILABLE",
            "BACKEND_EVIDENCE_UNAVAILABLE",
            "BACKEND_TURN_PATH_NOT_READY",
            "FRONTEND_TURN_PATH_NOT_READY",
            "BROWSER_CONNECTIVITY_CONTRACT_REJECTED"
          ]
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "frontendAcceptedAt": {
          "format": "date-time",
          "type": "string"
        },
        "frontendErrorCode": {
          "type": "string"
        },
        "frontendExpiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "frontendReason": {
          "type": "string"
        },
        "frontendState": {
          "enum": [
            "pending",
            "ready",
            "degraded",
            "not_ready",
            "unavailable"
          ]
        },
        "lastTransitionAt": {
          "format": "date-time",
          "type": "string"
        },
        "observedBrowserGeneration": {
          "type": "string"
        },
        "profileRevision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "reason": {
          "enum": [
            "BrowserNotRunning",
            "BrowserConnectivityPending",
            "BrowserConnectivityReady",
            "TURNProfileUnavailable",
            "BackendEvidenceUnavailable",
            "BackendTURNPathNotReady",
            "FrontendTURNPathNotReady",
            "BrowserConnectivityContractRejected"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "degraded",
            "not_ready",
            "unavailable"
          ]
        }
      },
      "required": [
        "contractVersion",
        "state",
        "admission",
        "reason",
        "backendState",
        "frontendState"
      ],
      "title": "Browser Connectivity Projection",
      "type": "object"
    },

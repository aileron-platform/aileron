# Canonical installation inputs for the root Aileron Docker Compose stack.
# Copy this file to .env and replace every /absolute/path example with an absolute host path.
# The Compose adapter derives callback, logout, CORS, internal service URLs, container paths,
# and service defaults. This file does not expose duplicate overrides for derived values.

# Platform public origin and OIDC
PLATFORM_PUBLIC_ORIGIN=http://localhost:8082
OIDC_ISSUER_URL=http://localhost:8080/realms/aileron
OIDC_CLIENT_ID=aileron-manager

# Installation identity and local administrator
TZ=Asia/Taipei
AILERON_INSTALLATION_ID=aileron-docker-dev
BOOTSTRAP_ADMIN_SUBJECT=00000000-0000-4000-8000-000000000001
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@aileron.com
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=keycloak-admin

# Host sources and Secret references
HOST_PROJECT_ROOT=/absolute/path/to/ai-developer-hub
HOST_PLATFORM_SECRETS_DIR=/absolute/path/to/platform-secrets
HOST_TURN_CONFIG_DIR=/absolute/path/to/turn-config
HOST_TURN_SECRETS_DIR=/absolute/path/to/turn-secrets

# Required files in HOST_PLATFORM_SECRETS_DIR:
# - platform-database-url (SQLAlchemy/PostgreSQL DSN with the non-superuser platform login)
# - redis-general-url (standalone redis:// or rediss:// URL with logical database)
# - redis-job-queue-url (standalone redis:// or rediss:// URL with logical database)
# - redis-job-result-url (standalone redis:// or rediss:// URL with logical database)
# - oidc-client-secret
# The bundled data-service overlay additionally requires:
# - postgres-bootstrap-superuser-password
# - postgres-platform-username
# - postgres-platform-password
# The local-oidc profile also requires:
# - keycloak-bootstrap-admin-password
# - local-oidc-platform-admin-password (defaults to admin123 only in an isolated local environment)
# The TURN readiness contract defines the required files in HOST_TURN_SECRETS_DIR.

# The private-CA overlay requires all four absolute host certificate paths.
HOST_PLATFORM_DATABASE_CA_CERT_FILE=/absolute/path/to/platform-database-ca.crt
HOST_REDIS_GENERAL_CA_CERT_FILE=/absolute/path/to/redis-general-ca.crt
HOST_REDIS_JOB_QUEUE_CA_CERT_FILE=/absolute/path/to/redis-job-queue-ca.crt
HOST_REDIS_JOB_RESULT_CA_CERT_FILE=/absolute/path/to/redis-job-result-ca.crt

# Docker and TURN installation inputs
TURN_CREDENTIAL_REVISION=docker-compose-v1
TURN_CONNECTIVITY_GATEWAY_EXTERNAL_PORT=18083
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49180

# Frontend build capability
VITE_BROWSER_EXTENSION_ID=

# Compose image selection (no cross-service image consistency check)
WORKSPACE_MANAGER_IMAGE=ailerondocker/workspace-manager:dev
WORKSPACE_OPERATOR_IMAGE=ailerondocker/workspace-operator:dev
WORKSPACE_RUNTIME_IMAGE=ailerondocker/workspace-runtime:dev-lite
WORKSPACE_BROWSER_IMAGE=ailerondocker/workspace-chrome:dev
WORKSPACE_CANVAS_IMAGE=ailerondocker/workspace-canvas:dev
WORKSPACE_UI_IMAGE=ailerondocker/workspace-ui:dev
COTURN_IMAGE=ailerondocker/platform-coturn:dev
PLATFORM_KEYCLOAK_IMAGE=ailerondocker/platform-keycloak:dev

# Aileron 環境變數設定範例
# 複製此檔案為 .env 並根據需求修改

# ============================================
# 系統時區設定
# ============================================
# 設定系統時區，所有容器和排程任務都會使用此時區
# 常用時區：
#   - Asia/Taipei (台北時間，UTC+8)
#   - UTC (協調世界時)
#   - America/Los_Angeles (太平洋時間)
#   - Europe/Berlin (柏林時間)
# 完整時區列表：https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Taipei

# ============================================
# 主機路徑設定
# ============================================
HOST_PROJECT_ROOT=${PWD}
HOST_WORKSPACE_RUNTIME_DIR=${PWD}/workspace-runtime
HOST_WORKSPACE_MANAGER_DIR=${PWD}/workspace-manager
HOST_WORKSPACES_DIR=${PWD}/data/workspace-data
HOST_WORKSPACE_SCRIPTS_DIR=${PWD}/data/workspace-scripts
HOST_CLAUDE_DATA_DIR=${PWD}/data/claude-data
HOST_SSH_KEYS_DIR=${PWD}/data/ssh-keys
BROWSER_WEBRTC_HOST_UDP_PORT=52330
BROWSER_WEBRTC_NAT1TO1_IP=127.0.0.1
BROWSER_WEBRTC_RESERVED_UDP_RANGES=50000-52321

# ============================================
# 運行環境
# ============================================
NODE_ENV=development

# ============================================
# 資料庫設定
# ============================================
POSTGRES_DB=aileron
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# JWT 認證設定
# ============================================
SECRET_KEY=aileron-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Redis 設定
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Celery 設定
# ============================================
# Celery 會自動使用 TZ 環境變數作為時區設定
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================
# Anthropic Claude API 設定
# ============================================
# 若需要自訂 Claude 相容端點，可額外設定 ANTHROPIC_BASE_URL
# 例如：
# ANTHROPIC_BASE_URL=https://api.example.com/anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here

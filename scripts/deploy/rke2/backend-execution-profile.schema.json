{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.aileron.dev/schemas/backend-execution-profile.schema.json",
  "title": "Aileron backend execution profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionNamespace",
    "namespaceOwner",
    "imagePullSecret",
    "nfsMountRoots",
    "localPathNodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aileron-backend-execution-profile/v1"
    },
    "executionNamespace": {
      "const": "aileron-backend-attestor-system"
    },
    "namespaceOwner": {
      "const": "aileron-installer"
    },
    "imagePullSecret": {
      "const": "harbor-rke-creds"
    },
    "nfsMountRoots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server", "path"],
        "properties": {
          "server": {
            "type": "string",
            "pattern": "^(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
          },
          "path": {
            "$ref": "#/$defs/absolutePath"
          }
        }
      }
    },
    "localPathNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "nodeUid", "mountRoots"],
        "properties": {
          "hostname": {
            "$ref": "#/$defs/dnsSubdomain"
          },
          "nodeUid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[-_.A-Za-z0-9]{0,126}[A-Za-z0-9])?$"
          },
          "mountRoots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/absolutePath"
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "nfsMountRoots": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "localPathNodes": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "labelValue": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
    }
  }
}

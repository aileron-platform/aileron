{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "realm", "issuerUrl", "platformCallbackUrl", "clientId", "images", "secrets", "postgres", "keycloak", "ingress", "networkPolicy", "backup", "restore"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePullSecrets"],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"$ref": "#/definitions/kubernetesName"}}
          }
        }
      }
    },
    "realm": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "issuerUrl": {"type": "string", "pattern": "^https://[^/]+/realms/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "platformCallbackUrl": {"type": "string", "pattern": "^https://[^/]+/api/v1/oauth2/callback$"},
    "clientId": {"type": "string", "minLength": 1},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keycloak", "postgres"],
      "properties": {
        "keycloak": {"$ref": "#/definitions/image"},
        "postgres": {"$ref": "#/definitions/image"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "keycloakAdministrator", "platformAdministrator", "breakGlass", "realmImport"],
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "usernameKey", "passwordKey"],
          "properties": {
            "name": {"$ref": "#/definitions/kubernetesName"},
            "usernameKey": {"$ref": "#/definitions/secretKey"},
            "passwordKey": {"$ref": "#/definitions/secretKey"}
          }
        },
        "keycloakAdministrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "usernameKey", "passwordKey"],
          "properties": {
            "name": {"$ref": "#/definitions/kubernetesName"},
            "usernameKey": {"$ref": "#/definitions/secretKey"},
            "passwordKey": {"$ref": "#/definitions/secretKey"}
          }
        },
        "platformAdministrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "subjectKey", "usernameKey", "emailKey", "passwordKey", "importKey"],
          "properties": {
            "name": {"$ref": "#/definitions/kubernetesName"},
            "subjectKey": {"$ref": "#/definitions/secretKey"},
            "usernameKey": {"$ref": "#/definitions/secretKey"},
            "emailKey": {"$ref": "#/definitions/secretKey"},
            "passwordKey": {"$ref": "#/definitions/secretKey"},
            "importKey": {"$ref": "#/definitions/secretKey"}
          }
        },
        "breakGlass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "usernameKey", "emailKey", "passwordKey"],
          "properties": {
            "name": {"$ref": "#/definitions/kubernetesName"},
            "usernameKey": {"$ref": "#/definitions/secretKey"},
            "emailKey": {"$ref": "#/definitions/secretKey"},
            "passwordKey": {"$ref": "#/definitions/secretKey"}
          }
        },
        "realmImport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "realmKey"],
          "properties": {
            "name": {"$ref": "#/definitions/kubernetesName"},
            "realmKey": {"$ref": "#/definitions/secretKey"}
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "database", "storage", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "database": {"type": "string", "minLength": 1},
        "jdbcUrl": {
          "type": "string",
          "pattern": "^jdbc:postgresql://[^/?#@]+(?::[1-9][0-9]{0,4})?/[^/?#]+(?:\\?[^#]*)?$",
          "not": {"pattern": "[?&](?:user|password|sslrootcert|sslcert|sslkey)="}
        },
        "revision": {"type": "string", "minLength": 1},
        "caSecretName": {"$ref": "#/definitions/kubernetesName"},
        "caSecretKey": {"$ref": "#/definitions/secretKey"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "storageClassName"],
          "properties": {
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
            "storageClassName": {"type": "string"},
            "mountRootSupplementalGroup": {
              "anyOf": [
                {"type": "integer", "minimum": 1, "maximum": 2147483647},
                {"type": "null"}
              ]
            }
          }
        },
        "resources": {"type": "object"}
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "admin"],
      "properties": {
        "public": {"$ref": "#/definitions/ingress"},
        "admin": {"$ref": "#/definitions/adminIngress"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressNamespaceLabels"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "externalDatabaseEgress": {
          "$ref": "#/definitions/externalDatabaseEgress"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "claimName", "storage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "claimName": {"$ref": "#/definitions/kubernetesName"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "storageClassName", "accessMode"],
          "properties": {
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
            "storageClassName": {"type": "string"},
            "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
            "mountRootSupplementalGroup": {
              "anyOf": [
                {"type": "integer", "minimum": 1, "maximum": 2147483647},
                {"type": "null"}
              ]
            }
          }
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "backup": {"properties": {"enabled": {"const": true}}},
          "restore": {"properties": {"enabled": {"const": true}}}
        },
        "required": ["backup", "restore"]
      }
    },
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {"enabled": {"enum": [false]}},
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {"required": ["jdbcUrl", "revision"]},
          "networkPolicy": {"required": ["externalDatabaseEgress"]}
        }
      },
      "else": {
        "properties": {
          "postgres": {
            "not": {
              "anyOf": [
                {"required": ["jdbcUrl"]},
                {"required": ["revision"]},
                {"required": ["caSecretName"]},
                {"required": ["caSecretKey"]}
              ]
            }
          },
          "networkPolicy": {
            "not": {"required": ["externalDatabaseEgress"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "postgres": {"required": ["caSecretName"]}
        }
      },
      "then": {
        "properties": {
          "postgres": {
            "required": ["caSecretKey"],
            "properties": {
              "jdbcUrl": {"pattern": "[?&]sslmode=verify-full(?:&|$)"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "postgres": {"required": ["caSecretKey"]}
        }
      },
      "then": {
        "properties": {
          "postgres": {"required": ["caSecretName"]}
        }
      }
    }
  ],
  "definitions": {
    "kubernetesName": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "secretKey": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "externalDatabaseEgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["selector", "ipBlock", "disabled"]},
        "namespaceLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "podLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "selector"}}},
          "then": {
            "required": ["namespaceLabels", "podLabels"],
            "not": {"required": ["cidr"]}
          }
        },
        {
          "if": {"properties": {"mode": {"const": "ipBlock"}}},
          "then": {
            "required": ["cidr"],
            "not": {
              "anyOf": [
                {"required": ["namespaceLabels"]},
                {"required": ["podLabels"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "disabled"}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["namespaceLabels"]},
                {"required": ["podLabels"]},
                {"required": ["cidr"]}
              ]
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "hostname", "tlsSecretName", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"$ref": "#/definitions/kubernetesName"},
        "hostname": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "tlsSecretName": {"$ref": "#/definitions/kubernetesName"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "adminIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "hostname", "tlsSecretName", "annotations", "allowedCidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"$ref": "#/definitions/kubernetesName"},
        "hostname": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "tlsSecretName": {"$ref": "#/definitions/kubernetesName"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "allowedCidrs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
        }
      }
    }
  }
}

# Aileron - Workspace Runtime 環境變數範例
# 複製此檔案為 .env 並修改相應值

# === 應用程式設定 ===
APP_NAME="Aileron - Workspace Runtime"
VERSION="1.0.0"
DEBUG=false
ENV=production

# === 伺服器設定 ===
HOST=0.0.0.0
PORT=3002

# === 資料庫設定 ===
# 使用與 Workspace Manager 相同的資料庫以讀取排程任務
DATABASE_URL=postgresql://postgres:password@localhost:5432/workspace_manager

# === 工作區設定 ===
WORKSPACE_ID=default
WORKSPACE_PATH=/workspace
WORKSPACE_USER=developer

# === Workspace Manager 連接設定 ===
MANAGER_URL=http://workspace-manager:8000
MANAGER_API_TOKEN=your-manager-api-token

# === CORS 設定 ===
ALLOWED_ORIGINS=*

# === 檔案監控設定 ===
WATCH_PATTERNS="*.py,*.js,*.ts,*.jsx,*.tsx,*.vue,*.json,*.md"
IGNORE_PATTERNS="node_modules/*,.git/*,__pycache__/*,*.pyc,.venv/*,venv/*,.env,*.log,.DS_Store"

# === 系統監控設定 ===
MONITOR_INTERVAL=5
CPU_THRESHOLD=80.0
MEMORY_THRESHOLD=85.0
DISK_THRESHOLD=90.0

# === WebSocket 設定 ===
WS_HEARTBEAT_INTERVAL=30
WS_MESSAGE_MAX_SIZE=1048576

# === 日誌設定 ===
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# === 開發工具設定 ===
AUTO_INSTALL_PACKAGES=true
PACKAGE_MANAGERS=npm,pip,yarn,pnpm

# === 執行環境設定 ===
NODE_VERSION=18
PYTHON_VERSION=3.11
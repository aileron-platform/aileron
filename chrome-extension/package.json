{
  "name": "aileron-extension",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "node scripts/chrome-release.mjs publish",
    "build:firefox": "wxt build --browser firefox",
    "verify:release": "node scripts/chrome-release.mjs verify",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  }
}

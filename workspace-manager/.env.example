# Aileron - Workspace Manager 環境變數範例
# 複製此檔案為 .env 並修改相應值

# === 應用程式設定 ===
APP_NAME="Aileron - Workspace Manager"
VERSION="1.0.0"
DEBUG=false
ENV=production

# === 伺服器設定 ===
HOST=0.0.0.0
PORT=8000

# === 資料庫設定 ===
DATABASE_URL=postgresql://postgres:password@postgres:5432/workspace_manager
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === Redis 設定 ===
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# === JWT 認證設定 ===
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# === CORS 設定 ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# === Docker 設定 ===
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=aileron
WORKSPACE_IMAGE_PREFIX=aidh-workspace

# === Celery 設定 ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === 檔案儲存設定 ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=.zip,.tar.gz,.tar,.py,.js,.ts,.json,.md

# === 日誌設定 ===
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# === 監控設定 ===
HEALTH_CHECK_TIMEOUT=30

# === Keycloak OAuth2/OIDC 認證設定 ===
# 啟用 Keycloak 認證（設置為 false 以使用原有認證系統）
ENABLE_AUTH=false
# Keycloak server URL（包含 realm）
KEYCLOAK_SERVER_URL=http://keycloak:8080/realms/aileron
# Keycloak realm 名稱
KEYCLOAK_REALM=aileron
# OAuth2 client ID
KEYCLOAK_CLIENT_ID=aileron-frontend
# OAuth2 client secret（從 Keycloak Admin Console 獲取）
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
# JWT token 驗證算法（預設使用 RS256）
JWT_ALGORITHM=RS256
# JWT token 有效期（分鐘）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
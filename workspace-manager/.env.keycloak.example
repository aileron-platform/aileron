# Keycloak OAuth2 認證配置
# 複製此文件到 .env 並修改配置

# ============================================================================
# 認證啟用開關
# ============================================================================
# 設置為 true 啟用 Keycloak OAuth2 認證
# 設置為 false 使用原有的 email/password 認證（向後兼容）
ENABLE_AUTH=true

# ============================================================================
# Keycloak 伺服器配置
# ============================================================================
# Keycloak 伺服器 URL
KEYCLOAK_SERVER_URL=http://localhost:8080/realms

# Keycloak Realm 名稱
KEYCLOAK_REALM=aileron

# OAuth2 Client ID
KEYCLOAK_CLIENT_ID=workspace-manager

# OAuth2 Client Secret（從 Keycloak Admin Console 獲取）
KEYCLOAK_CLIENT_SECRET=workspace-manager-secret-12345

# ============================================================================
# JWT Token 配置
# ============================================================================
# JWKS 快取 TTL（秒）
KEYCLOAK_JWKS_CACHE_TTL=3600

# Token 過期時間（秒）
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# 應用配置
# ============================================================================
# 應用 URL（用於 OAuth redirect）
APP_BASE_URL=http://localhost:3001

# Frontend URL（用於 CORS 和 redirect）
FRONTEND_URL=http://localhost:8082

# ============================================================================
# 說明
# ============================================================================
#
# 1. 啟動 Keycloak：
#    docker-compose up -d keycloak
#
# 2. 配置 Keycloak（參考 scripts/setup-keycloak.sh）：
#    - 創建 realm: aileron
#    - 創建 client: workspace-manager
#    - 創建測試用戶
#
# 3. 設置環境變數：
#    - 將此文件複製為 .env
#    - 修改配置值
#
# 4. 重啟應用：
#    - 重啟 workspace-manager 服務
#
# 5. 測試認證流程：
#    - 訪問 http://localhost:3001/api/v1/oauth2/login
#    - 使用 Keycloak 登入
#
# ============================================================================

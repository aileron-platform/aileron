#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_ID="{{ workspace.id }}"
WORKSPACE_NAME="{{ workspace.name }}"
RUNTIME_PORT={{ ports.default_internal_port }}

log() {
  echo "[${WORKSPACE_ID}] $1"
}

log "Initializing Workspace Runtime (${WORKSPACE_NAME})"

log "Creating base directory structure"
mkdir -p /workspace/src /workspace/docs /workspace/tests /workspace/config

log "Generating environment variable configuration"
cat <<'ENVVARS' > /workspace/config/.env
{% for key, value in environment.items() %}{{ key }}="{{ value }}"
{% endfor %}
ENVVARS

{% if git.url %}
log "Setting up Git repository {{ git.url }}"
if [ ! -d "/workspace/src/.git" ]; then
  git clone --branch "{{ git.branch }}" "{{ git.url }}" /workspace/src
else
  cd /workspace/src
  git fetch origin "{{ git.branch }}"
  git checkout "{{ git.branch }}"
  git pull origin "{{ git.branch }}"
fi
{% endif %}

log "Workspace Runtime initialization complete, ready to start services (port: ${RUNTIME_PORT})"
log "Custom setup script will run from start_services.sh (/scripts/custom-setup.sh)"

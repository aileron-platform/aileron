    def create_output_style_file(self, template_id: str, request):
        """建立新的 output style 檔案"""
        from app.models.template_config import TemplateOutputStyleResponse, TemplateOutputStyleContent

        # 標準化檔案名稱（自動補上 .md）
        normalized_file_name = self._normalize_file_name(request.file_name)

        _, error_response = self._validate_template_and_filename(
            template_id,
            TemplateOutputStyleResponse,
            file_name=normalized_file_name,
        )
        if error_response:
            return error_response

        styles_dir, _ = self._ensure_directory(template_id, "output-styles")
        style_file = styles_dir / normalized_file_name
        if style_file.exists():
            return TemplateOutputStyleResponse(success=False, error="Output style file already exists")

        try:
            content_model, error_message = self._write_file_with_stats(
                style_file,
                request.content,
                TemplateOutputStyleContent,
            )
            if error_message:
                return TemplateOutputStyleResponse(success=False, error=error_message)

            # 更新 plugin.json
            self._update_plugin_json(template_id)

            return TemplateOutputStyleResponse(
                success=True,
                data=content_model,
                message="Output style file created successfully",
            )
        except Exception as e:
            logger.error(f"建立 output style 檔案失敗: {e}")
            return TemplateOutputStyleResponse(
                success=False,
                error=f"Failed to create output style file: {str(e)}",
            )

    def update_output_style_file(self, template_id: str, file_name: str, request):
        """更新現有的 output style 檔案"""
        from app.models.template_config import TemplateOutputStyleResponse, TemplateOutputStyleContent

        _, error_response = self._validate_template_and_filename(
            template_id,
            TemplateOutputStyleResponse,
            file_name=file_name,
        )
        if error_response:
            return error_response

        style_file = self._get_template_dir(template_id) / "output-styles" / file_name
        if not style_file.exists():
            return TemplateOutputStyleResponse(success=False, error="Output style file not found")

        try:
            content_model, error_message = self._write_file_with_stats(
                style_file,
                request.content,
                TemplateOutputStyleContent,
            )
            if error_message:
                return TemplateOutputStyleResponse(success=False, error=error_message)

            # 更新 plugin.json
            self._update_plugin_json(template_id)

            return TemplateOutputStyleResponse(
                success=True,
                data=content_model,
                message="Output style file updated successfully",
            )
        except Exception as e:
            logger.error(f"更新 output style 檔案失敗: {e}")
            return TemplateOutputStyleResponse(
                success=False,
                error=f"Failed to update output style file: {str(e)}",
            )

    def delete_output_style_file(self, template_id: str, file_name: str):
        """刪除 output style 檔案"""
        from app.models.template_config import TemplateOutputStyleResponse

        _, error_response = self._validate_template_and_filename(
            template_id,
            TemplateOutputStyleResponse,
            file_name=file_name,
        )
        if error_response:
            return error_response

        style_file = self._get_template_dir(template_id) / "output-styles" / file_name
        if not style_file.exists():
            return TemplateOutputStyleResponse(success=False, error="Output style file not found")

        try:
            style_file.unlink()

            # 更新 plugin.json
            self._update_plugin_json(template_id)

            return TemplateOutputStyleResponse(
                success=True,
                message="Output style file deleted successfully",
            )
        except Exception as e:
            logger.error(f"刪除 output style 檔案失敗: {e}")
            return TemplateOutputStyleResponse(
                success=False,
                error=f"Failed to delete output style file: {str(e)}",
            )

    # ============ 檔案管理核心方法 ============

    def get_template_files(
        self,
        template_id: str,
        path: Optional[str] = None,
        include_content: bool = False,
        max_depth: int = -1,
        base_path: str = "scripts"
    ) -> TemplateFilesResponse:
        """取得模板檔案樹"""
        db_template = self._get_template(template_id)
        if not db_template:
            return TemplateFilesResponse(
                success=False,
                error="Template not found"
            )

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return TemplateFilesResponse(
                success=False,
                error="Invalid base_path. Must be 'scripts' or 'skills'"
            )

        files_dir = self._get_template_dir(template_id) / base_path
        if not files_dir.exists():
            files_dir.mkdir(parents=True, exist_ok=True)
            return TemplateFilesResponse(
                success=True,
                data=[],
                total_files=0,
                total_size=0,
                message="Files directory created"
            )

        try:
            # 建立檔案樹
            target_path = files_dir / path if path else files_dir
            if not target_path.exists():
                return TemplateFilesResponse(
                    success=False,
                    error=f"Path not found: {path}"
                )

            file_tree, total_files, total_size = self._build_file_tree(
                target_path,
                files_dir,
                include_content=include_content,
                max_depth=max_depth,
                current_depth=0
            )

            return TemplateFilesResponse(
                success=True,
                data=file_tree,
                total_files=total_files,
                total_size=total_size,
                message=f"Found {total_files} files"
            )
        except Exception as e:
            logger.error(f"取得檔案樹失敗: {e}")
            return TemplateFilesResponse(
                success=False,
                error=f"Failed to get file tree: {str(e)}"
            )

    def _build_file_tree(
        self,
        path: Path,
        base_path: Path,
        include_content: bool = False,
        max_depth: int = -1,
        current_depth: int = 0
    ) -> Tuple[List[FileNodeInfo], int, int]:
        """遞迴建立檔案樹"""
        nodes = []
        total_files = 0
        total_size = 0

        if max_depth != -1 and current_depth >= max_depth:
            return nodes, total_files, total_size

        try:
            items = sorted(path.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower()))

            for item in items:
                relative_path = str(item.relative_to(base_path))
                node_id = f"file-{relative_path.replace('/', '-')}"

                if item.is_file():
                    stat = item.stat()
                    content = None
                    if include_content and stat.st_size < self.MAX_TEMPLATE_FILE_SIZE_BYTES:
                        try:
                            content = item.read_text(encoding="utf-8")
                        except:
                            content = None

                    nodes.append(FileNodeInfo(
                        id=node_id,
                        name=item.name,
                        path=relative_path,
                        type="file",
                        size=stat.st_size,
                        content=content,
                        extension=item.suffix,
                        created_at=datetime.fromtimestamp(stat.st_ctime),
                        modified_at=datetime.fromtimestamp(stat.st_mtime)
                    ))
                    total_files += 1
                    total_size += stat.st_size

                elif item.is_dir():
                    children, child_files, child_size = self._build_file_tree(
                        item,
                        base_path,
                        include_content=include_content,
                        max_depth=max_depth,
                        current_depth=current_depth + 1
                    )

                    nodes.append(FileNodeInfo(
                        id=node_id,
                        name=item.name,
                        path=relative_path,
                        type="directory",
                        children=children,
                        created_at=datetime.fromtimestamp(item.stat().st_ctime),
                        modified_at=datetime.fromtimestamp(item.stat().st_mtime)
                    ))
                    total_files += child_files
                    total_size += child_size

        except Exception as e:
            logger.error(f"建立檔案樹失敗 {path}: {e}")

        return nodes, total_files, total_size

    def get_file_content(self, template_id: str, file_path: str, base_path: str = "scripts") -> FileContentResponse:
        """取得檔案內容"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileContentResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileContentResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        full_path = self._get_template_dir(template_id) / base_path / file_path
        if not full_path.exists() or not full_path.is_file():
            return FileContentResponse(success=False, error="File not found")

        # 安全檢查:確保路徑在模板目錄內
        if not self._is_safe_path(full_path, self._get_template_dir(template_id) / base_path):
            return FileContentResponse(success=False, error="Invalid file path")

        try:
            stat = full_path.stat()
            if stat.st_size > self.MAX_TEMPLATE_FILE_SIZE_BYTES:
                return FileContentResponse(
                    success=False,
                    error=f"File too large (max {self.MAX_TEMPLATE_FILE_SIZE_BYTES / 1024 / 1024}MB)"
                )

            content = full_path.read_text(encoding="utf-8")

            return FileContentResponse(
                success=True,
                data=FileNodeInfo(
                    id=f"file-{file_path.replace('/', '-')}",
                    name=full_path.name,
                    path=file_path,
                    type="file",
                    size=stat.st_size,
                    content=content,
                    extension=full_path.suffix,
                    modified_at=datetime.fromtimestamp(stat.st_mtime)
                ),
                message="File loaded successfully"
            )
        except Exception as e:
            logger.error(f"讀取檔案失敗: {e}")
            return FileContentResponse(
                success=False,
                error=f"Failed to read file: {str(e)}"
            )

    def create_file_or_directory(
        self,
        template_id: str,
        request: CreateFileRequest,
        base_path: str = "scripts"
    ) -> FileOperationResponse:
        """建立檔案或目錄"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileOperationResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileOperationResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        # 驗證路徑
        if not self._validate_file_path(request.path):
            return FileOperationResponse(success=False, error="Invalid file path")

        files_dir = self._get_template_dir(template_id) / base_path
        files_dir.mkdir(parents=True, exist_ok=True)

        target_path = files_dir / request.path

        # 安全檢查
        if not self._is_safe_path(target_path, files_dir):
            return FileOperationResponse(success=False, error="Invalid file path")

        if target_path.exists():
            return FileOperationResponse(
                success=False,
                error=f"{'Directory' if request.type == 'directory' else 'File'} already exists"
            )

        try:
            if request.type == "directory":
                target_path.mkdir(parents=True, exist_ok=True)
                return FileOperationResponse(
                    success=True,
                    data=FileNodeInfo(
                        id=f"dir-{request.path.replace('/', '-')}",
                        name=target_path.name,
                        path=request.path,
                        type="directory"
                    ),
                    message="Directory created successfully"
                )
            else:
                # 確保父目錄存在
                target_path.parent.mkdir(parents=True, exist_ok=True)

                # 檢查副檔名（轉換為小寫比較）
                if target_path.suffix and target_path.suffix.lower() not in self.ALLOWED_EXTENSIONS:
                    return FileOperationResponse(
                        success=False,
                        error=f"File extension {target_path.suffix} not allowed"
                    )

                # 檢查內容大小
                content = request.content or ""
                if len(content.encode("utf-8")) > self.MAX_TEMPLATE_FILE_SIZE_BYTES:
                    return FileOperationResponse(
                        success=False,
                        error=f"File content too large (max {self.MAX_TEMPLATE_FILE_SIZE_BYTES / 1024 / 1024}MB)"
                    )

                target_path.write_text(content, encoding="utf-8")
                stat = target_path.stat()

                return FileOperationResponse(
                    success=True,
                    data=FileNodeInfo(
                        id=f"file-{request.path.replace('/', '-')}",
                        name=target_path.name,
                        path=request.path,
                        type="file",
                        size=stat.st_size,
                        content=content,
                        extension=target_path.suffix
                    ),
                    message="File created successfully"
                )
        except Exception as e:
            logger.error(f"建立檔案/目錄失敗: {e}")
            return FileOperationResponse(
                success=False,
                error=f"Failed to create: {str(e)}"
            )

    def update_file_content(
        self,
        template_id: str,
        request: UpdateFileContentRequest,
        base_path: str = "scripts"
    ) -> FileOperationResponse:
        """更新檔案內容"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileOperationResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileOperationResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        full_path = self._get_template_dir(template_id) / base_path / request.path

        if not full_path.exists() or not full_path.is_file():
            return FileOperationResponse(success=False, error="File not found")

        if not self._is_safe_path(full_path, self._get_template_dir(template_id) / base_path):
            return FileOperationResponse(success=False, error="Invalid file path")

        try:
            # 檢查內容大小
            if len(request.content.encode("utf-8")) > self.MAX_TEMPLATE_FILE_SIZE_BYTES:
                return FileOperationResponse(
                    success=False,
                    error=f"File content too large (max {self.MAX_TEMPLATE_FILE_SIZE_BYTES / 1024 / 1024}MB)"
                )

            full_path.write_text(request.content, encoding="utf-8")
            stat = full_path.stat()

            return FileOperationResponse(
                success=True,
                data=FileNodeInfo(
                    id=f"file-{request.path.replace('/', '-')}",
                    name=full_path.name,
                    path=request.path,
                    type="file",
                    size=stat.st_size,
                    content=request.content,
                    extension=full_path.suffix,
                    modified_at=datetime.fromtimestamp(stat.st_mtime)
                ),
                message="File updated successfully"
            )
        except Exception as e:
            logger.error(f"更新檔案失敗: {e}")
            return FileOperationResponse(
                success=False,
                error=f"Failed to update file: {str(e)}"
            )

    async def upload_files(
        self,
        template_id: str,
        target_path: str,
        files: List[UploadFile],
        overwrite: bool = False,
        base_path: str = "scripts"
    ) -> FileUploadResponse:
        """上傳檔案"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileUploadResponse(
                success=False,
                uploaded=[],
                total=0,
                succeeded=0,
                failed=0,
                message="Template not found"
            )

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileUploadResponse(
                success=False,
                uploaded=[],
                total=0,
                succeeded=0,
                failed=0,
                message="Invalid base_path. Must be 'scripts' or 'skills'"
            )

        if len(files) > self.MAX_UPLOAD_FILES:
            return FileUploadResponse(
                success=False,
                uploaded=[],
                total=len(files),
                succeeded=0,
                failed=len(files),
                message=f"Too many files (max {self.MAX_UPLOAD_FILES})"
            )

        files_dir = self._get_template_dir(template_id) / base_path
        files_dir.mkdir(parents=True, exist_ok=True)

        target_dir = files_dir / target_path if target_path else files_dir
        if not self._is_safe_path(target_dir, files_dir):
            return FileUploadResponse(
                success=False,
                uploaded=[],
                total=len(files),
                succeeded=0,
                failed=len(files),
                message="Invalid target path"
            )

        target_dir.mkdir(parents=True, exist_ok=True)

        results = []
        succeeded = 0
        failed = 0

        for upload_file in files:
            try:
                # 驗證檔案名稱
                if not self._validate_filename(upload_file.filename):
                    results.append(UploadedFileInfo(
                        filename=upload_file.filename,
                        path="",
                        size=0,
                        success=False,
                        error="Invalid filename"
                    ))
                    failed += 1
                    continue

                # 檢查副檔名（轉換為小寫比較）
                file_ext = Path(upload_file.filename).suffix.lower()
                if file_ext and file_ext not in self.ALLOWED_EXTENSIONS:
                    results.append(UploadedFileInfo(
                        filename=upload_file.filename,
                        path="",
                        size=0,
                        success=False,
                        error=f"File extension {file_ext} not allowed"
                    ))
                    failed += 1
                    continue

                file_path = target_dir / upload_file.filename

                # 檢查是否已存在
                if file_path.exists() and not overwrite:
                    results.append(UploadedFileInfo(
                        filename=upload_file.filename,
                        path="",
                        size=0,
                        success=False,
                        error="File already exists"
                    ))
                    failed += 1
                    continue

                # 讀取並檢查大小
                content = await upload_file.read()
                if len(content) > self.MAX_TEMPLATE_FILE_SIZE_BYTES:
                    results.append(UploadedFileInfo(
                        filename=upload_file.filename,
                        path="",
                        size=len(content),
                        success=False,
                        error=f"File too large (max {self.MAX_TEMPLATE_FILE_SIZE_BYTES / 1024 / 1024}MB)"
                    ))
                    failed += 1
                    continue

                # 寫入檔案
                file_path.write_bytes(content)
                relative_path = str(file_path.relative_to(files_dir))

                results.append(UploadedFileInfo(
                    filename=upload_file.filename,
                    path=relative_path,
                    size=len(content),
                    success=True
                ))
                succeeded += 1

            except Exception as e:
                logger.error(f"上傳檔案失敗 {upload_file.filename}: {e}")
                results.append(UploadedFileInfo(
                    filename=upload_file.filename,
                    path="",
                    size=0,
                    success=False,
                    error=str(e)
                ))
                failed += 1

        return FileUploadResponse(
            success=failed == 0,
            uploaded=results,
            total=len(files),
            succeeded=succeeded,
            failed=failed,
            message=f"Uploaded {succeeded}/{len(files)} files successfully"
        )

    def rename_file(
        self,
        template_id: str,
        request: RenameFileRequest,
        base_path: str = "scripts"
    ) -> FileOperationResponse:
        """重命名檔案或目錄"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileOperationResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileOperationResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        files_dir = self._get_template_dir(template_id) / base_path
        old_path = files_dir / request.old_path

        if not old_path.exists():
            return FileOperationResponse(success=False, error="File or directory not found")

        if not self._is_safe_path(old_path, files_dir):
            return FileOperationResponse(success=False, error="Invalid file path")

        # 驗證新名稱(不包含路徑分隔符)
        if '/' in request.new_name or '\\' in request.new_name:
            return FileOperationResponse(success=False, error="Invalid new name: cannot contain path separators")

        # 檢查非法字符
        illegal_chars = r'[<>:"|?*\x00-\x1f]'
        if re.search(illegal_chars, request.new_name):
            return FileOperationResponse(success=False, error="Invalid new name: contains illegal characters")

        new_path = old_path.parent / request.new_name

        if new_path.exists():
            return FileOperationResponse(success=False, error="Target name already exists")

        try:
            old_path.rename(new_path)
            relative_path = str(new_path.relative_to(files_dir))

            return FileOperationResponse(
                success=True,
                data=FileNodeInfo(
                    id=f"{'dir' if new_path.is_dir() else 'file'}-{relative_path.replace('/', '-')}",
                    name=new_path.name,
                    path=relative_path,
                    type="directory" if new_path.is_dir() else "file"
                ),
                message="Renamed successfully"
            )
        except Exception as e:
            logger.error(f"重命名失敗: {e}")
            return FileOperationResponse(
                success=False,
                error=f"Failed to rename: {str(e)}"
            )

    def move_file(
        self,
        template_id: str,
        request: MoveFileRequest,
        base_path: str = "scripts"
    ) -> FileOperationResponse:
        """移動檔案或目錄"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileOperationResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileOperationResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        files_dir = self._get_template_dir(template_id) / base_path
        source_path = files_dir / request.source_path
        target_path = files_dir / request.target_path

        if not source_path.exists():
            return FileOperationResponse(success=False, error="Source not found")

        if not self._is_safe_path(source_path, files_dir) or not self._is_safe_path(target_path, files_dir):
            return FileOperationResponse(success=False, error="Invalid file path")

        if target_path.exists() and not request.overwrite:
            return FileOperationResponse(success=False, error="Target already exists")

        try:
            # 確保目標目錄存在
            target_path.parent.mkdir(parents=True, exist_ok=True)

            # 移動
            shutil.move(str(source_path), str(target_path))
            relative_path = str(target_path.relative_to(files_dir))

            return FileOperationResponse(
                success=True,
                data=FileNodeInfo(
                    id=f"{'dir' if target_path.is_dir() else 'file'}-{relative_path.replace('/', '-')}",
                    name=target_path.name,
                    path=relative_path,
                    type="directory" if target_path.is_dir() else "file"
                ),
                message="Moved successfully"
            )
        except Exception as e:
            logger.error(f"移動失敗: {e}")
            return FileOperationResponse(
                success=False,
                error=f"Failed to move: {str(e)}"
            )

    def copy_file(
        self,
        template_id: str,
        request: CopyFileRequest,
        base_path: str = "scripts"
    ) -> FileOperationResponse:
        """複製檔案或目錄"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileOperationResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileOperationResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        files_dir = self._get_template_dir(template_id) / base_path
        source_path = files_dir / request.source_path
        target_path = files_dir / request.target_path

        if not source_path.exists():
            return FileOperationResponse(success=False, error="Source not found")

        if not self._is_safe_path(source_path, files_dir) or not self._is_safe_path(target_path, files_dir):
            return FileOperationResponse(success=False, error="Invalid file path")

        if target_path.exists() and not request.overwrite:
            return FileOperationResponse(success=False, error="Target already exists")

        try:
            # 確保目標目錄存在
            target_path.parent.mkdir(parents=True, exist_ok=True)

            # 複製
            if source_path.is_dir():
                shutil.copytree(str(source_path), str(target_path), dirs_exist_ok=request.overwrite)
            else:
                shutil.copy2(str(source_path), str(target_path))

            relative_path = str(target_path.relative_to(files_dir))

            return FileOperationResponse(
                success=True,
                data=FileNodeInfo(
                    id=f"{'dir' if target_path.is_dir() else 'file'}-{relative_path.replace('/', '-')}",
                    name=target_path.name,
                    path=relative_path,
                    type="directory" if target_path.is_dir() else "file"
                ),
                message="Copied successfully"
            )
        except Exception as e:
            logger.error(f"複製失敗: {e}")
            return FileOperationResponse(
                success=False,
                error=f"Failed to copy: {str(e)}"
            )

    def delete_file(
        self,
        template_id: str,
        file_path: str,
        recursive: bool = False,
        base_path: str = "scripts"
    ) -> FileOperationResponse:
        """刪除檔案或目錄"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileOperationResponse(success=False, error="Template not found")

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return FileOperationResponse(success=False, error="Invalid base_path. Must be 'scripts' or 'skills'")

        files_dir = self._get_template_dir(template_id) / base_path
        target_path = files_dir / file_path

        if not target_path.exists():
            return FileOperationResponse(success=False, error="File or directory not found")

        if not self._is_safe_path(target_path, files_dir):
            return FileOperationResponse(success=False, error="Invalid file path")

        try:
            if target_path.is_dir():
                if not recursive:
                    return FileOperationResponse(
                        success=False,
                        error="Cannot delete directory without recursive flag"
                    )
                shutil.rmtree(target_path)
            else:
                target_path.unlink()

            return FileOperationResponse(
                success=True,
                message="Deleted successfully"
            )
        except Exception as e:
            logger.error(f"刪除失敗: {e}")
            return FileOperationResponse(
                success=False,
                error=f"Failed to delete: {str(e)}"
            )

    def batch_delete_files(
        self,
        template_id: str,
        request: BatchDeleteRequest,
        base_path: str = "scripts"
    ) -> BatchOperationResponse:
        """批次刪除檔案"""
        db_template = self._get_template(template_id)
        if not db_template:
            return BatchOperationResponse(
                success=False,
                results=[],
                total=0,
                succeeded=0,
                failed=0,
                message="Template not found"
            )

        # 驗證 base_path
        if base_path not in ["scripts", "skills"]:
            return BatchOperationResponse(
                success=False,
                results=[],
                total=0,
                succeeded=0,
                failed=0,
                message="Invalid base_path. Must be 'scripts' or 'skills'"
            )

        results = []
        succeeded = 0
        failed = 0

        for path in request.paths:
            result = self.delete_file(template_id, path, request.recursive, base_path)
            results.append(BatchOperationResult(
                path=path,
                success=result.success,
                error=result.error
            ))
            if result.success:
                succeeded += 1
            else:
                failed += 1

        return BatchOperationResponse(
            success=failed == 0,
            results=results,
            total=len(request.paths),
            succeeded=succeeded,
            failed=failed,
            message=f"Deleted {succeeded}/{len(request.paths)} items successfully"
        )

    def search_files(
        self,
        template_id: str,
        request: FileSearchRequest
    ) -> FileSearchResponse:
        """搜尋檔案"""
        db_template = self._get_template(template_id)
        if not db_template:
            return FileSearchResponse(
                success=False,
                results=[],
                total=0,
                query=request.query,
                error="Template not found"
            )

        files_dir = self._get_template_dir(template_id) / "scripts"
        if not files_dir.exists():
            return FileSearchResponse(
                success=True,
                results=[],
                total=0,
                query=request.query,
                message="No files directory"
            )

        try:
            results = []
            query_lower = request.query.lower()

            for item in files_dir.rglob("*"):
                if len(results) >= request.max_results:
                    break

                relative_path = str(item.relative_to(files_dir))

                # 檔案名稱匹配
                name_match = query_lower in item.name.lower()

                # 檔案類型篩選
                if request.file_types and item.is_file():
                    if item.suffix not in request.file_types:
                        continue

                content_matches = []
                if request.search_content and item.is_file():
                    try:
                        if item.stat().st_size < self.MAX_TEMPLATE_FILE_SIZE_BYTES:
                            content = item.read_text(encoding="utf-8")
                            if query_lower in content.lower():
                                # 提取匹配的行
                                lines = content.split('\n')
                                for i, line in enumerate(lines):
                                    if query_lower in line.lower():
                                        content_matches.append(f"Line {i+1}: {line.strip()[:100]}")
                                        if len(content_matches) >= 3:
                                            break
                    except:
                        pass

                if name_match or content_matches:
                    results.append(FileSearchResult(
                        path=relative_path,
                        name=item.name,
                        type="directory" if item.is_dir() else "file",
                        size=item.stat().st_size if item.is_file() else None,
                        matches=content_matches if content_matches else None
                    ))

            return FileSearchResponse(
                success=True,
                results=results,
                total=len(results),
                query=request.query,
                message=f"Found {len(results)} results"
            )
        except Exception as e:
            logger.error(f"搜尋失敗: {e}")
            return FileSearchResponse(
                success=False,
                results=[],
                total=0,
                query=request.query,
                error=f"Search failed: {str(e)}"
            )

    # ============ 輔助方法 ============

    def _validate_file_path(self, path: str) -> bool:
        """驗證檔案路徑"""
        if not path or path.startswith('/') or path.startswith('..'):
            return False

        # 檢查非法字符
        illegal_chars = r'[<>:"|?*\x00-\x1f]'
        if re.search(illegal_chars, path):
            return False

        return True

    def _is_safe_path(self, path: Path, base_path: Path) -> bool:
        """檢查路徑是否在基礎路徑內(防止路徑遍歷攻擊)"""
        try:
            path.resolve().relative_to(base_path.resolve())
            return True
        except ValueError:
            return False

    def export_template(self, template_id: str) -> Optional[Path]:
        """
        匯出模板為 ZIP 檔案

        Args:
            template_id: 模板 ID

        Returns:
            ZIP 檔案路徑，失敗返回 None
        """
        # 檢查模板是否存在
        db_template = self.db.query(TemplateDB).filter(TemplateDB.id == template_id).first()
        if not db_template:
            logger.error(f"模板不存在: {template_id}")
            return None

        # 模板目錄
        template_dir = self._get_template_dir(template_id)
        if not template_dir.exists():
            logger.error(f"模板目錄不存在: {template_dir}")
            return None

        try:
            # 建立臨時 ZIP 檔案
            temp_dir = Path(tempfile.gettempdir())
            zip_path = temp_dir / f"{template_id}.zip"

            # 打包模板目錄
            with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
                # 遍歷模板目錄下的所有檔案
                for file_path in template_dir.rglob('*'):
                    if file_path.is_file():
                        # 計算相對路徑（保留 template_id 作為根目錄）
                        arcname = template_id / file_path.relative_to(template_dir)
                        zipf.write(file_path, arcname)

            logger.info(f"模板匯出成功: {template_id} -> {zip_path}")
            return zip_path

        except Exception as e:
            logger.error(f"匯出模板失敗: {e}")
            return None

    def import_template(self, zip_file: UploadFile) -> Tuple[bool, str]:
        """
        匯入模板 ZIP 檔案

        Args:
            zip_file: 上傳的 ZIP 檔案

        Returns:
            (成功與否, 訊息)
        """
        temp_dir = None
        try:
            # 建立臨時目錄
            temp_dir = Path(tempfile.mkdtemp())
            zip_path = temp_dir / "upload.zip"

            # 儲存上傳的檔案
            with open(zip_path, 'wb') as f:
                shutil.copyfileobj(zip_file.file, f)

            # 解壓縮
            extract_dir = temp_dir / "extracted"
            extract_dir.mkdir()

            with zipfile.ZipFile(zip_path, 'r') as zipf:
                zipf.extractall(extract_dir)

            # 尋找 template_id 子目錄
            # ZIP 結構應該是: template_id/.claude-plugin/plugin.json, template_id/CLAUDE.md, ...
            subdirs = [d for d in extract_dir.iterdir() if d.is_dir()]

            if len(subdirs) == 0:
                return False, "ZIP 檔案中沒有找到模板目錄"

            if len(subdirs) > 1:
                return False, "ZIP 檔案中包含多個目錄，請確保只有一個模板目錄"

            template_dir = subdirs[0]
            template_id = template_dir.name

            # 驗證 template_id 格式
            if not self._validate_template_id(template_id):
                return False, f"無效的模板代號: {template_id}（必須是 kebab-case 格式）"

            # 檢查 plugin.json 是否存在
            plugin_file = template_dir / ".claude-plugin" / "plugin.json"
            if not plugin_file.exists():
                return False, f"模板目錄中缺少 .claude-plugin/plugin.json 檔案"

            # 解析 plugin.json
            try:
                with open(plugin_file, 'r', encoding='utf-8') as f:
                    plugin_data = json.load(f)
            except Exception as e:
                return False, f"無法解析 plugin.json: {str(e)}"

            # 驗證必要欄位
            required_fields = ['id', 'name', 'version', 'author']
            for field in required_fields:
                if field not in plugin_data:
                    return False, f"plugin.json 缺少必要欄位: {field}"

            # 檢查 ID 是否一致
            if plugin_data['id'] != template_id:
                return False, f"plugin.json 中的 id ({plugin_data['id']}) 與目錄名稱 ({template_id}) 不一致"

            # 檢查模板是否已存在
            existing_template = self.db.query(TemplateDB).filter(TemplateDB.id == template_id).first()
            if existing_template:
                return False, f"模板代號 {template_id} 已存在，無法匯入"

            # 複製模板目錄到 template-center/plugins
            target_dir = Path(settings.TEMPLATE_STORAGE_PATH) / "plugins" / template_id
            if target_dir.exists():
                shutil.rmtree(target_dir)

            shutil.copytree(template_dir, target_dir)

            # 建立資料庫記錄
            author_data = plugin_data.get('author', {})
            if isinstance(author_data, str):
                author_data = {'name': author_data}

            db_template = TemplateDB(
                id=template_id,
                name=plugin_data.get('name', template_id),
                description=plugin_data.get('description', ''),
                author_name=author_data.get('name', 'Unknown'),
                author_email=author_data.get('email'),
                author_url=author_data.get('url'),
                category=plugin_data.get('category'),
                version=plugin_data.get('version', '1.0.0'),
                cli_type=plugin_data.get('cli_type', 'ClaudeCode'),
                status='draft',
                keywords=plugin_data.get('keywords', []),
                init_commands=plugin_data.get('initCommands', ''),
                created_at=datetime.utcnow(),
                updated_at=datetime.utcnow(),
            )

            self.db.add(db_template)
            self.db.commit()

            logger.info(f"模板匯入成功: {template_id}")
            return True, f"模板 {template_id} 匯入成功"

        except Exception as e:
            logger.error(f"匯入模板失敗: {e}")
            return False, f"匯入失敗: {str(e)}"

        finally:
            # 清理臨時目錄
            if temp_dir and temp_dir.exists():
                try:
                    shutil.rmtree(temp_dir)
                except Exception as e:
                    logger.warning(f"清理臨時目錄失敗: {e}")

    def _validate_template_id(self, template_id: str) -> bool:
        """驗證模板 ID 格式（kebab-case）"""
        pattern = r'^[a-z][a-z0-9]*(-[a-z0-9]+)*$'
        return bool(re.match(pattern, template_id))


__all__ = ["TemplateService"]

# Development image shared by the local stack and container tests.
ARG NODE_IMAGE
FROM ${NODE_IMAGE}

ARG SOURCE_REVISION=development
ARG NPM_VERSION=12.0.1
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
RUN npm install -g "npm@${NPM_VERSION}" \
    && test "$(npm --version)" = "${NPM_VERSION}"

# Configure timezone.
ARG TZ=Asia/Taipei
ENV TZ=${TZ}

# Set the working directory.
WORKDIR /app

# Install locked dependencies once in the image.
COPY package.json package-lock.json .npmrc ./
RUN test "$(node -p "require('./package.json').packageManager")" = "npm@${NPM_VERSION}" \
    && npm ci --no-audit --no-fund

# Copy source for an immediately runnable local image.
COPY . .

EXPOSE 8082

CMD ["npm", "run", "dev"]

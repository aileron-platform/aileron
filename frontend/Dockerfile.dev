# Development image shared by the local stack and container tests.
ARG NODE_IMAGE
FROM ${NODE_IMAGE}

ARG NPM_VERSION
RUN npm install -g "npm@${NPM_VERSION}"

# Configure timezone.
ARG TZ=Asia/Taipei
ENV TZ=${TZ}

# Set the working directory.
WORKDIR /app

# Install locked dependencies once in the image.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy source for an immediately runnable local image.
COPY . .

EXPOSE 8082

CMD ["npm", "run", "dev"]

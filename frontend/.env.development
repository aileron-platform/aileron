# Aileron - Frontend 開發環境變數

# === API 配置 ===
VITE_API_BASE_URL=http://localhost:3001

# === Keycloak OAuth2/OIDC 認證設定 ===
# Keycloak server URL（不含 realm）
VITE_KEYCLOAK_SERVER_URL=http://localhost:8080
# Keycloak realm 名稱
VITE_KEYCLOAK_REALM=aileron
# OAuth2 client ID
VITE_KEYCLOAK_CLIENT_ID=aileron-frontend
VITE_RUNTIME_PROVISIONER=docker
VITE_WORKSPACE_K8S_ALLOWED_NAMESPACES=default,workspace-system
VITE_WORKSPACE_K8S_DEFAULT_NAMESPACE=workspace-system
VITE_CILIUM_ENABLED=false

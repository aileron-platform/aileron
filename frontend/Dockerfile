FROM node:20-alpine AS builder

ARG TZ=Asia/Taipei
# Build with placeholder values — replaced at container start by entrypoint
ARG VITE_API_BASE_URL=__VITE_API_BASE_URL__
ARG VITE_FRONTEND_PUBLIC_URL=__VITE_FRONTEND_PUBLIC_URL__
ARG VITE_KEYCLOAK_SERVER_URL=__VITE_KEYCLOAK_SERVER_URL__
ARG VITE_KEYCLOAK_REALM=__VITE_KEYCLOAK_REALM__
ARG VITE_KEYCLOAK_CLIENT_ID=__VITE_KEYCLOAK_CLIENT_ID__
ARG VITE_RUNTIME_PROVISIONER=__VITE_RUNTIME_PROVISIONER__
ARG VITE_WORKSPACE_K8S_ALLOWED_NAMESPACES=__VITE_WORKSPACE_K8S_ALLOWED_NAMESPACES__
ARG VITE_WORKSPACE_K8S_DEFAULT_NAMESPACE=__VITE_WORKSPACE_K8S_DEFAULT_NAMESPACE__
ARG VITE_CILIUM_ENABLED=__VITE_CILIUM_ENABLED__
ENV TZ=${TZ}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_FRONTEND_PUBLIC_URL=${VITE_FRONTEND_PUBLIC_URL}
ENV VITE_KEYCLOAK_SERVER_URL=${VITE_KEYCLOAK_SERVER_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_RUNTIME_PROVISIONER=${VITE_RUNTIME_PROVISIONER}
ENV VITE_WORKSPACE_K8S_ALLOWED_NAMESPACES=${VITE_WORKSPACE_K8S_ALLOWED_NAMESPACES}
ENV VITE_WORKSPACE_K8S_DEFAULT_NAMESPACE=${VITE_WORKSPACE_K8S_DEFAULT_NAMESPACE}
ENV VITE_CILIUM_ENABLED=${VITE_CILIUM_ENABLED}
RUN apk add --no-cache tzdata && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine AS runner

ARG TZ=Asia/Taipei
ENV TZ=${TZ}
RUN apk add --no-cache tzdata && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8082

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
